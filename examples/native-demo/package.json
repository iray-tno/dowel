{
  "name": "@dowel/example-native-demo",
  "version": "0.0.0",
  "private": true,
  "description": "React Native example, and the end-to-end check that a Dowel source survives a real Metro bundle.",
  "license": "MIT",
  "scripts": {
    "bundle": "node ./scripts/bundle.mjs",
    "bundle:production": "node ./scripts/bundle.mjs --production --platform android",
    "measure:production": "node ./scripts/measure-production.mjs",
    "test": "node ./scripts/bundle.mjs && node ./scripts/check-bundle.mjs && node ./scripts/measure-production.mjs"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@dowel/core": "workspace:*",
    "@dowel/runtime": "workspace:*",
    "react": "^19.2.0",
    "react-native": "^0.87.0"
  },
  "devDependencies": {
    "@dowel/metro-transformer": "workspace:*",
    "@react-native/metro-babel-transformer": "^0.87.0",
    "@react-native/metro-config": "^0.87.0",
    "metro": "^0.87.0"
  }
}
