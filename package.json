{
  "name": "hozo",
  "private": true,
  "version": "0.0.0",
  "description": "A Rust-powered universal UI compiler and accessibility-first layer for React Native.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test && node scripts/check-packages.mjs",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version": "changeset version && node scripts/package-metadata.mjs && pnpm install --lockfile-only",
    "check:packages": "node scripts/check-packages.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "26.2.0",
    "aria-query": "^5.3.2",
    "turbo": "^2.3.0",
    "typescript": "^7.0.2"
  }
}
