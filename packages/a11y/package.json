{
  "name": "@hozo/a11y",
  "version": "0.1.0",
  "description": "Complex accessibility primitives (Dialog, etc.) with runtime-managed focus and keyboard behavior.",
  "keywords": [
    "react-native",
    "accessibility",
    "a11y",
    "aria",
    "dialog"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/dowel.git",
    "directory": "packages/a11y"
  },
  "homepage": "https://github.com/iray-tno/dowel/tree/main/packages/a11y#readme",
  "bugs": {
    "url": "https://github.com/iray-tno/dowel/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-native": "^0.87.0"
  }
}
