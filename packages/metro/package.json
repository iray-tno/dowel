{
  "name": "@hozo/metro",
  "version": "0.1.0",
  "description": "Metro integration for the Hozo compiler (Native lowering backend).",
  "keywords": [
    "metro",
    "react-native",
    "expo",
    "transformer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/dowel.git",
    "directory": "packages/metro"
  },
  "homepage": "https://github.com/iray-tno/dowel/tree/main/packages/metro#readme",
  "bugs": {
    "url": "https://github.com/iray-tno/dowel/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "default": "./dist/project.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "@hozo/compiler": "workspace:^",
    "@hozo/runtime": "workspace:^",
    "@hozo/tailwind": "workspace:^"
  },
  "peerDependencies": {
    "@react-native/metro-babel-transformer": "*"
  },
  "peerDependenciesMeta": {
    "@react-native/metro-babel-transformer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.2.0"
  }
}
