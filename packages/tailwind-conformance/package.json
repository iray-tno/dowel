{
  "name": "@dowel/tailwind-conformance",
  "version": "0.0.0",
  "private": true,
  "description": "Differential test: compares Dowel's compiled CSS against the real Tailwind engine's output, per utility.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 src/*.test.ts",
    "report": "node src/run.ts"
  },
  "dependencies": {
    "@dowel/a11y": "workspace:^",
    "@dowel/compiler": "workspace:*",
    "@dowel/metro-transformer": "workspace:^",
    "@dowel/runtime": "workspace:^",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.0",
    "react-test-renderer": "^19.2.8",
    "typescript": "^7.0.2"
  }
}
